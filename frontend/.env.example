# Backend API base URL (must end with /api)
# For local development: http://localhost:5000/api
# For production (Render/Railway): https://your-backend-service.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Currency symbol/code (e.g. INR, USD, EUR)
VITE_CURRENCY=INR

# Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
