NODE_ENV=production
PORT=5000

# MongoDB connection string (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/subtracker?retryWrites=true&w=majority

# JWT secret key for signing auth tokens (e.g. generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google Gemini API key for subscription cancel insights
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Email reminders via Gmail App Password (optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Allowed frontend origins (comma-separated if multiple, e.g. "http://localhost:5173,https://your-app.vercel.app")
CLIENT_URL=http://localhost:5173,https://your-frontend-app.vercel.app

# Google OAuth (optional, for Google Sign-in)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Defaults
CURRENCY=INR
TIMEZONE=Asia/Kolkata
REMINDER_CRON=0 9 * * *